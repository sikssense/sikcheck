# 식스체크(SikCheck) 로컬 설정 — 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요. (.env 는 공유·커밋하지 않아요)

# 검수 대상 (개발계)
TARGET_BASE_URL=
TARGET_TEST_USERNAME=
TARGET_TEST_PASSWORD=

# Figma Personal Access Token (Settings → Security → Personal access tokens)
FIGMA_TOKEN=

# Anthropic API Key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
